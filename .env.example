# 环境配置
ENV=development
DEBUG=true
LOCAL_DEV=true

# 数据库配置 (本地开发)
DATABASE_URL=sqlite:///sovi_demo.db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sovi_demo
DB_USER=postgres
DB_PASSWORD=your_password

# Google Cloud配置 (本地开发时留空或填入你的配置)
GCP_PROJECT_ID=
INSTANCE_CONNECTION_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini API配置
GEMINI_API_KEY=your-gemini-api-key

# 会话配置
SESSION_EXPIRY_DAYS=7

# 文件上传配置
MAX_FILE_SIZE_MB=10

# 存储配置
USE_GCS_STORAGE=false
GCS_BUCKET_NAME=
LOCAL_STORAGE_PATH=temp_image_storage

# 日志配置
LOG_LEVEL=INFO
